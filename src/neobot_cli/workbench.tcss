Screen { background: $background; }
#topbar { height: 1; padding: 0 2; background: $panel; }
#brand { width: 10; text-style: bold; color: $primary; }
#tagline { width: 1fr; color: $text-muted; }
#instance-state { width: auto; max-width: 42; height: 1; color: $text-muted; }
#instance-state.running { color: $success; }
#instance-state.stopping { color: $warning; }
#workspace { height: 1fr; padding: 1 2 0 2; overflow: hidden hidden; }
#workspace.no-project { align: center middle; }
#project-section {
    width: 72; max-width: 100%; height: auto;
    padding: 1 2; border: round $panel; background: $surface;
}
#project-section:focus-within { border: round $primary; }
#project-heading { height: 1; text-style: bold; margin-bottom: 1; }
#project-hint { height: auto; margin-bottom: 1; color: $text-muted; }
#instance-path { height: 1; text-overflow: ellipsis; text-wrap: nowrap; color: $text-muted; }
.no-project #instance-path { display: none; }
#project-path { height: 3; margin-bottom: 1; }
#setup-feedback { height: 2; }
#project-status { width: 1fr; min-width: 0; height: 2; color: $primary; text-overflow: ellipsis; }
#project-status.error { color: $error; }
#setup-details { visibility: hidden; width: 10; min-width: 8; margin: 0; }
#project-actions { height: 3; align-vertical: middle; }
.has-project #project-section {
    width: 100%; height: 1; border: none; padding: 0; background: $background;
}
.has-project #project-heading, .has-project #project-hint, .has-project #setup-feedback { display: none; }
#instance-actions { height: 3; align-vertical: middle; }
.no-project #instance-actions, .no-project #workbench-body { display: none; }
#workbench-body { height: 1fr; min-height: 22; padding-bottom: 1; }
#plugin-section, #plugin-editor, #result-pane {
    min-height: 0; padding: 0 1;
    border: round $panel; border-title-color: $text-muted;
    background: $surface;
}
#plugin-section:focus-within, #plugin-editor:focus-within, #result-pane:focus-within {
    border: round $primary; border-title-color: $primary;
}
#plugin-section { width: 28; height: 1fr; }
#plugin-summary { height: 2; margin-top: 1; color: $text-muted; }
#plugin-empty { height: auto; color: $text-muted; margin-bottom: 1; }
#plugin-table { height: 1fr; min-height: 4; background: $surface; scrollbar-size: 1 1; }
#plugin-table > .datatable--cursor { background: $primary-muted; color: $foreground; }
#detail-column { width: 1fr; height: 1fr; margin-left: 1; }
#plugin-editor { height: 11; }
#plugin-context { height: 2; text-overflow: ellipsis; color: $text-muted; }
#plugin-form { height: 4; }
.field { height: 4; width: 1fr; min-width: 0; }
.field Label { height: 1; color: $text-muted; }
#name-field { margin-right: 2; }
#template, #plugin-name { height: 3; width: 100%; }
#template-description { height: 1; color: $text-muted; text-overflow: ellipsis; }
#plugin-actions { height: 1; margin-top: 1; }
Button.compact {
    height: 1; min-height: 1; width: auto; min-width: 8;
    padding: 0 1; margin-right: 1; border: none;
    background: $panel; color: $foreground;
}
Button.compact:hover { background: $boost; }
Button.compact:focus { background: $primary-muted; text-style: bold; }
Button.compact.primary { background: $primary; color: $background; text-style: bold; }
Button.compact:disabled { background: $surface; color: $text-disabled; text-style: none; }
#result-pane { height: 1fr; min-height: 9; margin-top: 1; }
#operation-state { height: auto; max-height: 3; margin-bottom: 1; color: $primary; }
#result-empty { height: auto; color: $text-muted; }
#result-log {
    height: 1fr; min-height: 3; overflow: auto auto; scrollbar-size: 1 1; scrollbar-gutter: stable;
    background: $surface; scrollbar-background: $surface;
}
#workspace.short { overflow-y: auto; }
.short #workbench-body { height: 22; }
#workspace.narrow { padding: 0 1; overflow-y: auto; }
#workspace.narrow #workbench-body { layout: vertical; height: auto; min-height: 0; padding-bottom: 1; }
.narrow #plugin-section { width: 100%; height: 10; min-height: 10; }
.narrow #plugin-summary { height: 1; margin-top: 0; }
.narrow #detail-column { width: 100%; height: auto; margin: 1 0 0 0; }
.narrow #result-pane { height: 12; min-height: 12; }
.narrow Button.compact { min-width: 7; margin-right: 0; padding: 0; }
.narrow #name-field { margin-right: 1; }
.tiny #tagline { display: none; }
.tiny #instance-state { max-width: 16; text-overflow: ellipsis; text-wrap: nowrap; }
.tiny.no-project #project-section { padding: 1; }
.tiny #project-actions { layout: grid; grid-size: 1; grid-rows: 1; grid-gutter: 1 0; height: 3; }
.tiny #instance-actions { layout: grid; grid-size: 2; grid-rows: 1; grid-gutter: 1; height: 5; margin: 1 0; }
.tiny #plugin-editor { height: 18; }
.tiny #plugin-form { layout: vertical; height: 8; }
.tiny .field { width: 100%; }
.tiny #name-field { margin: 0; }
.tiny #template-description { height: 2; }
.tiny #plugin-actions { layout: grid; grid-size: 2; grid-rows: 1; grid-gutter: 1; height: 3; }
.tiny #instance-actions Button, .tiny #plugin-actions Button { width: 100%; min-width: 0; }
Footer { background: $panel; color: $text-muted; }
