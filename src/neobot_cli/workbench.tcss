Screen { background: $background; }
#topbar { height: 1; padding: 0 2; background: $panel; }
#brand { width: 10; text-style: bold; color: $primary; }
#tagline { width: 1fr; color: $text-muted; }
#instance-state { width: auto; max-width: 42; height: 1; color: $text-muted; }
#instance-state.running { color: $success; }
#instance-state.stopping { color: $warning; }
#workspace { height: 1fr; padding: 1 2 0 2; overflow: hidden hidden; }
#workspace.no-project { align: center middle; }
#project-section {
    width: 72; max-width: 100%; height: auto;
    padding: 1 2; border: round $panel; background: $surface;
}
#project-section:focus-within { border: round $primary; }
#project-heading { height: 1; text-style: bold; margin-bottom: 1; }
#project-hint { height: auto; margin-bottom: 1; color: $text-muted; }
#project-path { height: 3; margin-bottom: 1; }
#setup-feedback { height: 2; }
#project-status { width: 1fr; min-width: 0; height: 2; color: $primary; text-overflow: ellipsis; }
#project-status.error, #operation-state.error { color: $error; }
#setup-details { visibility: hidden; width: 10; min-width: 8; margin: 0; }
#project-actions { height: 3; align-vertical: middle; }
.no-project #instance-path, .no-project #navigation, .no-project #activity-strip, .no-project #pages { display: none; }
#instance-path { height: 1; text-overflow: ellipsis; text-wrap: nowrap; color: $text-muted; }
#navigation { height: 3; align-vertical: middle; }
Button.nav {
    height: 2; min-height: 2; width: 12; min-width: 8;
    padding: 0 2; margin-right: 1; border: none; border-bottom: solid $panel;
    background: $background; color: $text-muted;
}
Button.nav.active { color: $primary; border-bottom: solid $primary; text-style: bold; }
Button.nav:hover, Button.nav:focus { background: $panel; color: $foreground; }
#activity-strip { height: 2; padding: 0 1; margin-bottom: 1; background: $surface; border-left: thick $primary; }
#activity-summary { width: 1fr; height: 2; }
#operation-state { height: 1; color: $primary; text-wrap: nowrap; text-overflow: ellipsis; }
#operation-detail { height: 1; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
#open-activity { margin-top: 1; }
#pages { height: 1fr; }
.page { height: 1fr; padding-bottom: 0; overflow-x: hidden; }
.page-title { height: 1; margin-bottom: 0; text-style: bold; color: $foreground; }
.page-subtitle { height: 1; margin-bottom: 1; color: $text-muted; text-overflow: ellipsis; }
.eyebrow { height: 1; margin-bottom: 1; color: $text-muted; }
.muted { color: $text-muted; height: auto; margin-top: 1; }
.card { padding: 0 2; border: round $panel; background: $surface; }
#overview-cards { height: 6; }
#runtime-card { width: 2fr; height: 6; margin-right: 1; }
#plugins-card { width: 1fr; height: 6; }
#runtime-summary, #overview-plugins { height: 1; text-style: bold; color: $primary; }
#runtime-hint { height: 1; color: $text-muted; text-overflow: ellipsis; }
#go-plugins { margin-top: 0; }
#instance-actions { height: 3; align-vertical: middle; }
#next-step { height: auto; min-height: 7; }
#next-step .eyebrow { margin-bottom: 0; }
#next-step .muted { margin-top: 0; }
#next-step Static { height: auto; }
#plugin-section, #plugin-editor, #result-pane {
    min-height: 0; padding: 1 2;
    border: round $panel; border-title-color: $text-muted; background: $surface;
}
#plugin-section:focus-within, #plugin-editor:focus-within, #result-pane:focus-within {
    border: round $primary; border-title-color: $primary;
}
#plugin-section { width: 28; height: 1fr; }
#plugin-summary { height: 2; color: $text-muted; }
#plugin-empty { height: auto; color: $text-muted; margin-bottom: 1; }
#plugin-table { height: 1fr; min-height: 2; background: $surface; scrollbar-size: 1 1; }
#plugin-table > .datatable--cursor { background: $primary-muted; color: $foreground; }
#plugin-editor { padding: 0 2; width: 1fr; height: 1fr; margin-left: 1; }
#plugin-context { height: 2; text-overflow: ellipsis; color: $text-muted; }
#plugin-form { height: 8; }
.field { height: 4; width: 100%; min-width: 0; }
.field Label { height: 1; color: $text-muted; }
#template, #plugin-name { height: 3; width: 100%; }
#template-description { height: 1; color: $text-muted; text-overflow: ellipsis; }
#plugin-actions { height: 1; margin-top: 1; }
Button.compact {
    height: 1; min-height: 1; width: auto; min-width: 8;
    padding: 0 1; margin-right: 1; border: none;
    background: $panel; color: $foreground;
}
Button.compact:hover { background: $boost; }
Button.compact:focus { background: $primary-muted; text-style: bold; }
Button.compact.primary { background: $primary; color: $background; text-style: bold; }
Button.compact:disabled { background: $surface; color: $text-disabled; text-style: none; }
#result-pane { height: 1fr; min-height: 4; padding: 0 1; }
#result-empty { height: auto; color: $text-muted; }
#result-log { height: 1fr; min-height: 2; overflow: auto auto; scrollbar-size: 1 1; scrollbar-gutter: stable; background: $surface; }
#workspace.narrow { padding: 0 1; }
.narrow #plugins-page { layout: vertical; overflow-y: auto; }
.narrow #plugin-section { width: 100%; height: 9; min-height: 9; padding: 0 1; }
.narrow #plugin-summary { height: 1; }
.narrow #plugin-editor { width: 100%; height: 23; min-height: 23; margin: 1 0 0 0; }
.narrow Button.compact { min-width: 7; margin-right: 0; padding: 0; }
.tiny #tagline { display: none; }
.tiny #instance-state { max-width: 16; text-overflow: ellipsis; text-wrap: nowrap; }
.tiny.no-project #project-section { padding: 1; }
.tiny #project-actions { layout: grid; grid-size: 1; grid-rows: 1; grid-gutter: 1 0; height: 3; }
.tiny Button.nav { width: 1fr; padding: 0; margin: 0; }
.tiny #activity-strip { padding: 0; }
.tiny #open-activity { display: none; }
.narrow #overview-cards { layout: vertical; height: 14; }
.narrow #runtime-card, .narrow #plugins-card { width: 100%; margin: 0; }
.tiny #instance-actions { layout: grid; grid-size: 2; grid-rows: 1; grid-gutter: 1; height: 5; margin: 1 0; }
.tiny #plugin-actions { layout: grid; grid-size: 2; grid-rows: 1; grid-gutter: 1; height: 3; }
.tiny #plugin-editor { height: 25; min-height: 25; padding: 0 1; }
.tiny #instance-actions Button, .tiny #plugin-actions Button { width: 100%; min-width: 0; }
Footer { background: $panel; color: $text-muted; }
